---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import '../styles/global.css';
---
<Base
  title="Contact WaiverTemplate | Get in Touch"
  description="Have a question about WaiverTemplate? Contact us using the form below. We'll get back to you as soon as possible."
>
  <Nav />
  <Breadcrumbs items={[
    { label: 'Home', href: '/' },
    { label: 'Contact', href: '/contact/' },
  ]} />

  <section class="contact-section">
    <div class="contact-inner">
      <div class="contact-header">
        <h1>Get in Touch</h1>
        <p>Have a question about WaiverMaker, a bug to report, or feedback to share? Fill in the form and we'll get back to you.</p>
      </div>

      <div class="contact-layout">
        <!-- Left: form -->
        <div class="contact-form-wrap">
          <form id="contact-form" class="contact-form" novalidate>
            <div class="form-group">
              <label for="name">Your Name</label>
              <input type="text" id="name" name="name" required placeholder="Jane Smith" />
            </div>
            <div class="form-group">
              <label for="email">Your Email</label>
              <input type="email" id="email" name="email" required placeholder="jane@example.com" />
            </div>
            <div class="form-group">
              <label for="subject">Subject</label>
              <input type="text" id="subject" name="subject" placeholder="Question about WaiverMaker" />
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" required placeholder="Tell us how we can help..."></textarea>
            </div>
            <button type="submit" class="contact-submit" id="submit-btn">
              Send Message &rarr;
            </button>
            <div id="form-status" class="form-status" style="display:none;"></div>
          </form>
        </div>

        <!-- Right: info -->
        <div class="contact-info">
          <div class="info-card">
            <div class="info-icon">&#9889;</div>
            <h3>Quick responses</h3>
            <p>We aim to respond to all messages within 1&ndash;2 business days.</p>
          </div>
          <div class="info-card">
            <div class="info-icon">&#128274;</div>
            <h3>Privacy</h3>
            <p>Your email address is used only to respond to your message. We don't add you to any mailing list.</p>
          </div>
          <div class="info-card">
            <div class="info-icon">&#128196;</div>
            <h3>About WaiverMaker</h3>
            <p>Free waiver generator for gyms, tattoo studios, climbing facilities, and more. <a href="/">Try it now &rarr;</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn  = document.getElementById('submit-btn') as HTMLButtonElement;
  const status = document.getElementById('form-status') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Sending\u2026';
    status.style.display = 'none';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        body: new FormData(form),
      });
      const json = await res.json();

      if (json.ok) {
        status.textContent = '\u2713 Message sent! We\'ll get back to you soon.';
        status.className = 'form-status success';
        status.style.display = 'block';
        form.reset();
      } else {
        throw new Error(json.error || 'Unknown error');
      }
    } catch (err) {
      status.textContent = '\u2717 Failed to send. Please try again in a moment.';
      status.className = 'form-status error';
      status.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Message \u2192';
    }
  });
</script>

<style>
  .contact-section {
    background: white;
    padding: 60px 40px 80px;
  }
  .contact-inner {
    max-width: 1000px;
    margin: 0 auto;
  }
  .contact-header {
    margin-bottom: 48px;
  }
  .contact-header h1 {
    font-size: 40px;
    font-weight: 900;
    letter-spacing: -1px;
    color: #111827;
    margin-bottom: 12px;
  }
  .contact-header p {
    font-size: 17px;
    color: #6B7280;
    line-height: 1.6;
    max-width: 540px;
  }
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    align-items: start;
  }
  .contact-form-wrap {
    background: white;
    border: 1.5px solid #E5E7EB;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.07);
  }
  .form-group {
    margin-bottom: 20px;
  }
  .form-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 6px;
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid #E5E7EB;
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #111827;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    resize: vertical;
    box-sizing: border-box;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    border-color: #059669;
    box-shadow: 0 0 0 3px rgba(5,150,105,0.1);
  }
  .contact-submit {
    width: 100%;
    background: #059669;
    color: white;
    border: none;
    padding: 14px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    transition: background 0.15s;
    margin-top: 4px;
    font-family: 'Inter', sans-serif;
  }
  .contact-submit:hover { background: #047857; }
  .contact-submit:disabled { background: #9CA3AF; cursor: not-allowed; }
  .form-status {
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
  }
  .form-status.success { background: #ECFDF5; color: #059669; border: 1.5px solid #A7F3D0; }
  .form-status.error   { background: #FEF2F2; color: #DC2626; border: 1.5px solid #FECACA; }
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .info-card {
    background: #F9FAFB;
    border: 1.5px solid #E5E7EB;
    border-radius: 12px;
    padding: 20px;
  }
  .info-icon { font-size: 24px; margin-bottom: 10px; }
  .info-card h3 { font-size: 15px; font-weight: 700; color: #111827; margin-bottom: 6px; }
  .info-card p  { font-size: 13px; color: #6B7280; line-height: 1.6; margin: 0; }
  .info-card a  { color: #059669; text-decoration: none; }
  .info-card a:hover { text-decoration: underline; }
  @media (max-width: 768px) {
    .contact-section { padding: 40px 20px 60px; }
    .contact-layout { grid-template-columns: 1fr; }
    .contact-header h1 { font-size: 30px; }
  }
</style>
