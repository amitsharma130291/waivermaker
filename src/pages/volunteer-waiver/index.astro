---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import WaiverForm from '../../components/WaiverForm.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
---
<Base
  title="Free Volunteer Waiver Generator | Volunteer Liability Waiver Form"
  description="Create a volunteer liability waiver in seconds. Covers assumption of risk, indemnification, medical consent. Free to preview and download."
>
  <Nav />

  <!-- Hero + Tool: 2-column on desktop, stacked on mobile -->
  <section class="seo-hero">
    <div class="seo-hero-inner">
      <!-- Left: Hero content -->
      <div class="seo-hero-left">
        <div class="hero-badge">✓ 100% Free — No Account Needed</div>
        <h1>Free Volunteer Waiver — <span class="highlight">Ready in Under a Minute</span></h1>
        <p class="hero-sub">Generate a well-structured volunteer liability waiver for your organisation. Free to preview and download.</p>
        <div class="hero-trust">
          <span>🔒 No account needed</span>
          <span>·</span>
          <span>Preview free</span>
          <span>·</span>
          <span>Download free</span>
        </div>
      </div>

      <!-- Right: Tool -->
      <div class="seo-hero-right">
        <WaiverForm preselectedActivity="Volunteer" />
      </div>
    </div>
  </section>

  <!-- Supporting content -->
  <div class="seo-content">

    <!-- What Your Waiver Will Contain -->
    <section class="content-section">
      <h2>What Your Waiver Will Contain</h2>
      <p>Your generated volunteer waiver will include these clauses — each tailored to your organisation's name and activities.</p>
      <div class="clause-preview-list">
        <div class="clause-preview-item">
          <strong>Assumption of Risk</strong>
          <p>Your waiver will identify specific risks volunteers may encounter, including physical activities, environmental conditions, and tasks particular to your event or programme.</p>
        </div>
        <div class="clause-preview-item">
          <strong>Scope of Volunteer Duties</strong>
          <p>Your waiver will document the specific duties the volunteer is participating in — important for limiting liability to agreed activities only.</p>
        </div>
        <div class="clause-preview-item">
          <strong>Indemnification &amp; Hold Harmless</strong>
          <p>Your waiver will protect the organisation from third-party claims arising from the volunteer's actions during their role.</p>
        </div>
        <div class="clause-preview-item">
          <strong>Emergency Medical Consent</strong>
          <p>Your waiver authorises emergency treatment if the volunteer is incapacitated — critical for remote or outdoor events.</p>
        </div>
        <div class="clause-preview-item">
          <strong>Photo/Media Release</strong>
          <p>An optional, separately initialled clause for event documentation and promotional use.</p>
        </div>
      </div>
    </section>

    <!-- What a volunteer waiver must cover -->
    <section class="content-section" style="padding-top: 0;">
      <h2>What a Volunteer Waiver Must Cover</h2>
      <p>A volunteer waiver is not a one-size-fits-all document. It must address the specific risks of your organisation's activities and protect you from the liability gaps that exist because volunteers are not employees. Every effective volunteer waiver should include:</p>
      <div class="clauses-grid">
        <div class="clause-card">
          <div class="clause-num">1</div>
          <div>
            <strong>Assumption of Risk</strong>
            <p>The volunteer explicitly acknowledges the physical and other risks associated with their volunteer role and accepts those risks voluntarily.</p>
          </div>
        </div>
        <div class="clause-card">
          <div class="clause-num">2</div>
          <div>
            <strong>Indemnification</strong>
            <p>The volunteer agrees to hold the organisation harmless from any claims, damages, or costs arising from their participation.</p>
          </div>
        </div>
        <div class="clause-card">
          <div class="clause-num">3</div>
          <div>
            <strong>Emergency Medical Consent</strong>
            <p>Authorises the organisation to seek emergency medical treatment on behalf of the volunteer if they are incapacitated.</p>
          </div>
        </div>
        <div class="clause-card">
          <div class="clause-num">4</div>
          <div>
            <strong>Photo / Media Release</strong>
            <p>Permits the organisation to photograph or record the volunteer for use in promotional materials, social media, and reports.</p>
          </div>
        </div>
        <div class="clause-card">
          <div class="clause-num">5</div>
          <div>
            <strong>Scope of Volunteer Duties</strong>
            <p>Defines what activities the volunteer is authorised to perform and confirms they understand the boundaries of their role.</p>
          </div>
        </div>
        <div class="clause-card">
          <div class="clause-num">6</div>
          <div>
            <strong>No Employment Relationship</strong>
            <p>Explicitly states that the volunteer is not an employee, contractor, or agent of the organisation — critical for tax and liability purposes.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Volunteer Waiver Sub-Intents -->
    <section class="content-section">
      <h2>Volunteer Waivers by Context</h2>
      <p>Volunteer waivers differ meaningfully depending on your organisation type and how you engage volunteers. Here is how to think about each situation.</p>

      <div class="sub-intent-block">
        <h3>Nonprofit vs. Event vs. Church vs. School</h3>
        <ul class="sub-intent-list">
          <li><strong>Nonprofit / charity:</strong> Focus on ongoing programme risks and protecting the organisation from claims arising from regular volunteer duties. A standing annual waiver works if the activities are consistent.</li>
          <li><strong>One-off events:</strong> Scope your waiver to the specific event date, location, and activities. Broad language covering unrelated activities can appear misleading if disputed.</li>
          <li><strong>Church / faith organisations:</strong> Often involve minors in youth programmes, mission trips, and community outreach. Parental consent clauses are essential for any volunteer under 18.</li>
          <li><strong>School volunteering:</strong> May sit alongside district-level policies. An organisational waiver does not replace district requirements — check with the school's risk management team.</li>
        </ul>
      </div>

      <div class="sub-intent-block">
        <h3>Per-Event vs. Annual Waiver</h3>
        <p>A blanket annual waiver is appropriate only when the volunteer's activities and associated risks are consistent across the year. Where activities change event-to-event — from administrative tasks one month to physical outdoor work the next — separate event-specific waivers reduce ambiguity about exactly what the volunteer consented to.</p>
      </div>

      <div class="sub-intent-block">
        <h3>Minor Volunteer Considerations</h3>
        <p>A parent or legal guardian must sign for any volunteer under 18. Some states have additional requirements for minors in work-adjacent voluntary roles. Consult a local attorney if your programme regularly engages volunteers under 18 — do not assume a parental signature alone is sufficient in all jurisdictions.</p>
      </div>
    </section>

    <!-- Who needs a volunteer waiver -->
    <section class="content-section alt-bg">
      <h2>Who Needs a Volunteer Waiver</h2>
      <p>Any organisation that engages unpaid volunteers should have a signed waiver on file before those volunteers perform any activities. This includes:</p>
      <div class="who-grid">
        <div class="who-card">
          <span class="who-icon">🏛️</span>
          <strong>Nonprofits &amp; Charities</strong>
          <p>501(c)(3) organisations are not automatically exempt from liability for volunteer injuries. A signed waiver can form part of your organisation's broader risk-management and consent process.</p>
        </div>
        <div class="who-card">
          <span class="who-icon">🎉</span>
          <strong>Events &amp; Festivals</strong>
          <p>One-day events with large volunteer crews face concentrated risk. Collect waivers at check-in — before anyone starts setting up.</p>
        </div>
        <div class="who-card">
          <span class="who-icon">🏘️</span>
          <strong>Community Organisations</strong>
          <p>Neighbourhood groups, civic clubs, and community boards all need volunteer waivers for clean-up days, builds, and events.</p>
        </div>
        <div class="who-card">
          <span class="who-icon">⛪</span>
          <strong>Churches &amp; Faith Groups</strong>
          <p>Mission trips, food banks, and community outreach programmes carry real physical risks that a waiver documents and addresses.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="content-section">
      <h2>Volunteer Waiver — Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Are volunteers covered by workers' compensation?</summary>
          <p>Workers' compensation treatment of volunteers varies by state and organisation type. Some volunteers may be excluded from standard employee coverage, while certain organisations or jurisdictions provide specific protections. Check with your insurer or a local attorney.</p>
        </details>
        <details class="faq-item">
          <summary>Can one waiver cover all events?</summary>
          <p>Only if the scope of activities and associated risks are substantially the same across events. Where activities differ, event-specific waivers reduce ambiguity about what the volunteer consented to.</p>
        </details>
        <details class="faq-item">
          <summary>What if a volunteer refuses to sign?</summary>
          <p>Organisations commonly make completion of required waivers a condition of participation. Your ability to require a particular waiver may depend on the organisation, activity, jurisdiction, and applicable policies.</p>
        </details>
        <details class="faq-item">
          <summary>Does a waiver protect against gross negligence?</summary>
          <p>No. Liability waivers generally cannot shield an organisation from claims of gross negligence, wilful misconduct, or reckless disregard for safety. A waiver covers ordinary inherent risks, not organisational failures.</p>
        </details>
        <details class="faq-item">
          <summary>Is this legal advice?</summary>
          <p>No. WaiverMaker produces template documents to assist with documenting volunteer consent. For advice specific to your organisation and state, consult a licensed attorney.</p>
        </details>
      </div>
    </section>

    <!-- Related -->
    <section class="content-section related-section">
      <h2>More Liability Waiver Types</h2>
      <div class="related-links">
        <a href="/tattoo-waiver/" class="related-card">
          <span class="related-icon">🎨</span>
          <div>
            <strong>Tattoo Studio Waiver</strong>
            <p>Generate a tattoo studio liability waiver covering informed consent, allergy risks, and aftercare.</p>
          </div>
          <span class="related-arrow">›</span>
        </a>
        <a href="/rock-climbing-waiver/" class="related-card">
          <span class="related-icon">🧗</span>
          <div>
            <strong>Rock Climbing Waiver</strong>
            <p>Waiver for climbing gyms and outdoor guide services — covers equipment, fall risk, and more.</p>
          </div>
          <span class="related-arrow">›</span>
        </a>
      </div>
    </section>

  </div>

  <Footer />
</Base>

<style>
  .seo-hero {
    background: white;
    padding: 60px 40px;
    border-bottom: 1px solid #E5E7EB;
  }
  .seo-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .seo-hero-left { padding-top: 8px; }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #ECFDF5;
    color: #059669;
    padding: 5px 14px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 20px;
  }
  .seo-hero-left h1 {
    font-size: 42px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -1.5px;
    color: #111827;
    margin-bottom: 16px;
  }
  .highlight { color: #059669; }
  .hero-sub {
    font-size: 17px;
    color: #6B7280;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .hero-trust {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #6B7280;
    flex-wrap: wrap;
  }

  .seo-content { background: white; }
  .content-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 40px;
  }
  .content-section.alt-bg {
    max-width: 100%;
    background: #F9FAFB;
    border-top: 1px solid #E5E7EB;
    border-bottom: 1px solid #E5E7EB;
    padding: 60px 40px;
  }
  .content-section h2 {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: #111827;
    margin-bottom: 16px;
  }
  .content-section > p {
    color: #6B7280;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  /* Clause preview list */
  .clause-preview-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 24px;
  }
  .clause-preview-item {
    background: #F9FAFB;
    border: 1.5px solid #E5E7EB;
    border-left: 4px solid #059669;
    border-radius: 8px;
    padding: 14px 18px;
  }
  .clause-preview-item strong {
    display: block;
    color: #111827;
    font-size: 14px;
    margin-bottom: 4px;
  }
  .clause-preview-item p {
    color: #6B7280;
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
  }

  /* Sub-intent blocks */
  .sub-intent-block {
    margin-bottom: 28px;
  }
  .sub-intent-block h3 {
    font-size: 17px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 10px;
  }
  .sub-intent-block p {
    font-size: 14px;
    color: #6B7280;
    line-height: 1.6;
    margin: 0;
  }
  .sub-intent-list {
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }
  .sub-intent-list li {
    font-size: 14px;
    color: #374151;
    line-height: 1.6;
  }
  .sub-intent-list strong { color: #111827; }

  .clauses-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .clause-card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: white;
    border: 1.5px solid #E5E7EB;
    border-radius: 12px;
    padding: 18px;
  }
  .clause-num {
    width: 28px;
    height: 28px;
    background: #059669;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .clause-card strong { display: block; color: #111827; margin-bottom: 4px; font-size: 14px; }
  .clause-card p { color: #6B7280; font-size: 13px; line-height: 1.5; margin: 0; }

  .who-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 900px;
    margin: 0 auto;
  }
  .who-card {
    background: white;
    border: 1.5px solid #E5E7EB;
    border-radius: 12px;
    padding: 20px;
  }
  .who-icon { font-size: 26px; display: block; margin-bottom: 10px; }
  .who-card strong { display: block; font-size: 14px; color: #111827; margin-bottom: 6px; }
  .who-card p { font-size: 13px; color: #6B7280; line-height: 1.5; margin: 0; }

  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  .faq-item {
    border: 1.5px solid #E5E7EB;
    border-radius: 10px;
    padding: 16px 20px;
  }
  .faq-item summary {
    font-weight: 600;
    color: #111827;
    font-size: 15px;
    list-style: none;
    cursor: pointer;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] summary { color: #059669; margin-bottom: 10px; }
  .faq-item p { color: #6B7280; font-size: 14px; line-height: 1.6; margin: 0; }

  .related-section { border-top: 1px solid #E5E7EB; }
  .related-links { display: flex; flex-direction: column; gap: 12px; }
  .related-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: white;
    border: 1.5px solid #E5E7EB;
    border-radius: 12px;
    padding: 20px;
    text-decoration: none;
    color: #111827;
    transition: all 0.15s;
  }
  .related-card:hover { border-color: #059669; transform: translateY(-1px); }
  .related-icon { font-size: 24px; }
  .related-card strong { display: block; font-size: 15px; margin-bottom: 3px; }
  .related-card p { font-size: 13px; color: #6B7280; margin: 0; }
  .related-arrow { margin-left: auto; color: #6B7280; font-size: 20px; }

  @media (max-width: 768px) {
    .seo-hero { padding: 40px 20px; }
    .seo-hero-inner { grid-template-columns: 1fr; gap: 32px; }
    .seo-hero-left h1 { font-size: 30px; }
    .clauses-grid { grid-template-columns: 1fr; }
    .who-grid { grid-template-columns: 1fr; }
    .content-section { padding: 40px 20px; }
    .content-section.alt-bg { padding: 40px 20px; }
  }
</style>
