---
export const prerender = true;
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import WaiverForm from '../components/WaiverForm.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedWaivers from '../components/RelatedWaivers.astro';
import { waiverTypes } from '../data/waiver-types';
import '../styles/global.css';

export const getStaticPaths: GetStaticPaths = async () => {
  return waiverTypes.map(w => ({
    params: { waiver: w.slug },
    props: { waiver: w },
  }));
};

const { waiver } = Astro.props;

// Activity map: slug -> activityType for WaiverForm preset
const activityMap: Record<string, string> = {
  'gym-waiver':              'Gym/Fitness',
  'yoga-waiver':             'Yoga Studio',
  'dog-grooming-waiver':     'Dog Grooming',
  'horse-riding-waiver':     'Horse Riding',
  'personal-trainer-waiver': 'Personal Training',
  'tattoo-waiver':           'Tattoo Studio',
  'rock-climbing-waiver':    'Rock Climbing',
  'volunteer-waiver':        'Volunteer',
};
const presetActivity = activityMap[waiver.slug] || waiver.activityType || '';

// FAQPage schema — built from the waiver's clauses as FAQ items
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: waiver.clauses.slice(0, 6).map((clause: string) => ({
    '@type': 'Question',
    name: `Does a ${waiver.title.toLowerCase()} cover ${clause.toLowerCase()}?`,
    acceptedAnswer: {
      '@type': 'Answer',
      text: `Yes. WaiverMaker's ${waiver.title.toLowerCase()} template includes a clause addressing ${clause.toLowerCase()}. The exact language is tailored to your business details and selected governing state. Consult a licensed attorney for advice specific to your situation.`,
    },
  })),
};

// BreadcrumbList schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://waivermaker.com' },
    { '@type': 'ListItem', position: 2, name: waiver.title, item: `https://waivermaker.com/${waiver.slug}/` },
  ],
};
---
<Base
  title={`${waiver.title} | Generate Free — WaiverMaker`}
  description={waiver.metaDescription}
  schema={[faqSchema, breadcrumbSchema]}
>
  <Nav />

  <div class="landing-hero">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: waiver.title, href: `/${waiver.slug}/` },
    ]} />
    <div class="landing-hero-inner">
      <div class="waiver-hero-layout">
        <!-- Left: copy -->
        <div class="waiver-hero-copy">
          <div style="font-size:48px;margin-bottom:12px;">{waiver.emoji}</div>
          <h1>{waiver.title}</h1>
          {waiver.intro.map((p: string) => <p>{p}</p>)}

          <h2>Key Clauses in Your {waiver.title}</h2>
          <ul class="clauses-list">
            {waiver.clauses.map((c: string) => <li>{c}</li>)}
          </ul>

          <!-- Sub-page cross-links -->
          {waiver.slug === 'tattoo-waiver' && (
            <div class="subpage-links">
              <h3>More tools</h3>
              <a href="/tattoo-waiver/template/">📄 View the full template</a>
              <a href="/tattoo-waiver/form/">📝 Go straight to the form</a>
            </div>
          )}
        </div>

        <!-- Right: WaiverForm pre-set -->
        <div class="waiver-hero-form">
          <WaiverForm preselectedActivity={presetActivity} />
          <div class="form-note" style="max-width:620px;margin:12px auto 0;text-align:center;">
            🔒 Not legal advice · Consult an attorney for your specific situation
          </div>
        </div>
      </div>
    </div>
  </div>

  <RelatedWaivers currentSlug={waiver.slug} />

  <Footer />
</Base>

<style>
  .landing-hero {
    padding: 40px 0 0;
  }
  .landing-hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .waiver-hero-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .waiver-hero-copy h1 {
    font-size: 36px;
    font-weight: 900;
    margin-bottom: 16px;
    color: var(--dark, #0f172a);
  }
  .waiver-hero-copy p {
    color: var(--muted, #475569);
    line-height: 1.7;
    margin-bottom: 14px;
  }
  .waiver-hero-copy h2 {
    font-size: 20px;
    font-weight: 700;
    margin: 28px 0 12px;
    color: var(--dark, #0f172a);
  }
  .clauses-list {
    padding-left: 20px;
    color: var(--muted, #475569);
    line-height: 1.8;
  }
  .subpage-links {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .subpage-links h3 {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted, #64748b);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }
  .subpage-links a {
    font-size: 14px;
    color: var(--emerald, #059669);
    text-decoration: none;
  }
  .subpage-links a:hover {
    text-decoration: underline;
  }
  .waiver-hero-form {
    position: sticky;
    top: 20px;
  }
  @media (max-width: 768px) {
    .waiver-hero-layout {
      grid-template-columns: 1fr;
    }
    .waiver-hero-form {
      position: static;
    }
  }
</style>
