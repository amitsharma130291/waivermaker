---
export const prerender = true;
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import WaiverForm from '../components/WaiverForm.astro';
import Footer from '../components/Footer.astro';
import { waiverTypes } from '../data/waiver-types';
import '../styles/global.css';

export const getStaticPaths: GetStaticPaths = async () => {
  return waiverTypes.map(w => ({
    params: { waiver: w.slug },
    props: { waiver: w },
  }));
};

const { waiver } = Astro.props;
---
<Base
  title={`${waiver.title} | Generate Free — WaiverMaker`}
  description={waiver.metaDescription}
>
  <Nav />

  <div class="landing-hero">
    <div class="breadcrumb" style="max-width:900px;margin:0 auto 16px;">
      <a href="/">Home</a>
      <span>›</span>
      <span>{waiver.title}</span>
    </div>
    <div style="max-width:900px;margin:0 auto;">
      <div style="font-size:48px;margin-bottom:16px;">{waiver.emoji}</div>
      <h1>{waiver.title}</h1>
      {waiver.intro.map(p => <p>{p}</p>)}
    </div>
  </div>

  <div class="landing-content">
    <h2>Key Clauses in Your {waiver.title}</h2>
    <p>Every {waiver.title.toLowerCase()} generated by WaiverMaker includes these activity-specific provisions:</p>
    <ul class="clauses-list">
      {waiver.clauses.map(c => <li>{c}</li>)}
    </ul>

    <h2>Generate Your {waiver.title} Now</h2>
    <p>Fill in your business details below and preview your completed waiver for free. Pay $9.99 only when you're ready to download the PDF.</p>
  </div>

  <div style="padding: 0 40px 60px; background: white;">
    <WaiverForm preselectedActivity={waiver.activityType} />
    <div class="form-note" style="max-width:620px;margin:16px auto 0;">
      🔒 Not legal advice · Consult an attorney for your specific situation
    </div>
  </div>

  <Footer />
</Base>
