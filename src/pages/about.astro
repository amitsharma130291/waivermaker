---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import '../styles/global.css';
---
<Base title="About WaiverMaker" description="Learn what WaiverMaker does and does not provide. Free liability waiver generator for small businesses.">
  <Nav />
  <main class="legal-page">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about/' },
    ]} />
    <article class="legal-content">
      <h1>About WaiverMaker</h1>
      <p>WaiverMaker builds free tools that help small businesses and activity operators create, customise and manage liability waiver documents.</p>
      <h2>What we do</h2><p>We generate customisable waiver templates for common business activities: gyms, tattoo studios, climbing facilities, volunteer organisations, dog groomers, yoga studios, horse riding schools, personal trainers, and more. Users fill in their business details, choose their activity type, and receive a PDF they can print or use digitally.</p>
      <h2>What we don't do</h2><p>WaiverMaker is not a law firm. We do not provide legal advice. Our documents are templates: they are not guaranteed to be enforceable in every jurisdiction or to satisfy every legal or regulatory requirement applicable to your specific situation. We recommend consulting a licensed attorney in your state for legal advice.</p>
      <h2>Contact</h2><p>Questions or feedback: <a href="mailto:support@waivermaker.com">support@waivermaker.com</a></p>
      <h2>The product</h2><p>WaiverMaker is a free service. PDF downloads require no account or payment.</p>

      <p>We cover the most common waiver types including <a href="/gym-waiver/">gym waivers</a>, <a href="/tattoo-waiver/">tattoo studio waivers</a>, <a href="/rock-climbing-waiver/">rock climbing waivers</a>, <a href="/volunteer-waiver/">volunteer waivers</a>, and <a href="/yoga-waiver/">yoga studio waivers</a>.</p>
    </article>

    <!-- Generator CTA -->
    <div class="about-generator-cta">
      <h2>Try the Generator</h2>
      <p>Generate your free waiver now — no account needed.</p>
      <a href="/" class="cta-button">Generate My Waiver &rarr;</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .about-generator-cta {
    max-width: 680px;
    margin: 48px auto 60px;
    padding: 36px 40px;
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    border: 1px solid #bbf7d0;
    border-radius: 16px;
    text-align: center;
  }
  .about-generator-cta h2 {
    font-size: 24px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 8px;
  }
  .about-generator-cta p {
    color: #475569;
    margin-bottom: 20px;
  }
  .cta-button {
    display: inline-block;
    background: #059669;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .cta-button:hover {
    background: #047857;
  }
</style>
