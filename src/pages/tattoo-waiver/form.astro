---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import WaiverForm from '../../components/WaiverForm.astro';
import '../../styles/global.css';
---
<Base
  title="Tattoo Waiver Form | Fill Out Your Studio Liability Waiver"
  description="Complete your tattoo studio liability waiver form in 2 minutes. Free preview, free download. No account required."
>
  <!-- Minimal nav: logo + back link only -->
  <nav class="form-nav">
    <a href="/" class="nav-logo">waiver<span>maker</span></a>
    <a href="/tattoo-waiver/" class="nav-back">← Back to Tattoo Waiver</a>
  </nav>

  <main class="form-page">
    <div class="form-page-header">
      <h1>Create Your Tattoo Studio Waiver</h1>
      <p class="form-page-sub">Takes 2 minutes. Free to preview.</p>
    </div>

    <div class="form-page-body">
      <WaiverForm preselectedActivity="Tattoo Studio" />
    </div>

    <div class="form-page-trust">
      🔒 No account needed · Preview free · Pay free to download
    </div>
  </main>

  <footer class="form-footer">
    <a href="/" class="footer-logo">waiver<span>maker</span></a>
    <div>© 2026 WaiverMaker.com · Not legal advice</div>
    <div class="footer-links">
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </div>
  </footer>
</Base>

<style>
  /* Minimal conversion-focused nav */
  .form-nav {
    background: white;
    border-bottom: 1px solid #E5E7EB;
    padding: 0 40px;
    height: 60px;
    display: flex;
    align-items: center;
  }
  .nav-logo {
    font-size: 20px;
    font-weight: 800;
    color: #111827;
    letter-spacing: -0.5px;
    text-decoration: none;
  }
  .nav-logo span { color: #059669; }
  .nav-back {
    margin-left: auto;
    font-size: 14px;
    color: #6B7280;
    text-decoration: none;
    font-weight: 500;
  }
  .nav-back:hover { color: #059669; }

  /* Main form page layout */
  .form-page {
    min-height: calc(100vh - 120px);
    background: #F9FAFB;
    padding: 48px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .form-page-header {
    text-align: center;
    margin-bottom: 28px;
  }
  .form-page-header h1 {
    font-size: 30px;
    font-weight: 900;
    letter-spacing: -1px;
    color: #111827;
    margin-bottom: 8px;
  }
  .form-page-sub {
    font-size: 16px;
    color: #6B7280;
  }

  .form-page-body {
    width: 100%;
    max-width: 660px;
  }

  .form-page-trust {
    margin-top: 16px;
    font-size: 13px;
    color: #6B7280;
    text-align: center;
  }

  /* Minimal footer */
  .form-footer {
    background: #111827;
    padding: 24px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: rgba(255,255,255,0.4);
    font-size: 13px;
  }
  .footer-logo {
    color: white;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.5px;
    text-decoration: none;
  }
  .footer-logo span { color: #059669; }
  .footer-links { display: flex; gap: 16px; }
  .footer-links a {
    color: rgba(255,255,255,0.4);
    text-decoration: none;
  }
  .footer-links a:hover { color: white; }

  @media (max-width: 768px) {
    .form-nav { padding: 0 20px; }
    .form-page { padding: 32px 16px; }
    .form-page-header h1 { font-size: 24px; }
    .form-footer { flex-direction: column; gap: 12px; text-align: center; padding: 24px 20px; }
  }
</style>
