---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<Base title="Terms of Service — WaiverTemplate" description="WaiverTemplate.com terms of service." noindex={true}>
  <Nav />
  <div class="landing-content" style="padding-top:60px;">
    <h1 style="font-size:32px;font-weight:900;margin-bottom:24px;color:var(--dark);">Terms of Service</h1>
    <p><strong>Last updated:</strong> August 2026</p>
    <h2>Service Description</h2>
    <p>WaiverTemplate.com provides an online tool to generate liability waiver documents. The documents generated are templates for informational purposes only and do not constitute legal advice.</p>
    <h2>Not Legal Advice</h2>
    <p>The waivers generated by WaiverTemplate.com are not legal advice and do not create an attorney-client relationship. You should consult a licensed attorney in your jurisdiction to ensure any waiver meets your specific legal needs and is enforceable under local law.</p>
    <h2>Downloads</h2>
    <p>Waiver PDF downloads are completely free. No payment or account is required. If you experience a technical issue, contact us via our <a href="/contact/" style="color:var(--emerald);">contact page</a>.</p>
    <h2>Acceptable Use</h2>
    <p>You may use WaiverTemplate.com only for lawful purposes. You may not use generated documents for fraudulent purposes or misrepresent the legal status of generated waivers.</p>
    <h2>Limitation of Liability</h2>
    <p>WaiverTemplate.com is not liable for the legal sufficiency, enforceability, or outcome of any waiver generated using our service. Use of generated documents is entirely at your own risk.</p>
    <h2>Contact</h2>
    <p>Questions? <a href="/contact/" style="color:var(--emerald);">Contact us</a></p>
  </div>

  <div class="policy-cta">
    <a href="/">&larr; Back to WaiverTemplate</a>
    <a href="/" class="cta-button">Generate Free Waiver &rarr;</a>
  </div>

  <Footer />
</Base>

<style>
  .policy-cta {
    max-width: 680px;
    margin: 0 auto 60px;
    padding: 24px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid #e2e8f0;
  }
  .policy-cta a:first-child {
    color: var(--muted, #64748b);
    text-decoration: none;
    font-size: 14px;
  }
  .policy-cta a:first-child:hover {
    color: #0f172a;
  }
  .cta-button {
    display: inline-block;
    background: #059669;
    color: #fff !important;
    font-weight: 700;
    font-size: 14px;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
  }
  .cta-button:hover {
    background: #047857;
  }
</style>
