---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<Base title="Terms of Service — WaiverMaker" description="WaiverMaker.com terms of service.">
  <Nav />
  <div class="landing-content" style="padding-top:60px;">
    <h1 style="font-size:32px;font-weight:900;margin-bottom:24px;color:var(--dark);">Terms of Service</h1>
    <p><strong>Last updated:</strong> August 2026</p>
    <h2>Service Description</h2>
    <p>WaiverMaker.com provides an online tool to generate liability waiver documents. The documents generated are templates for informational purposes only and do not constitute legal advice.</p>
    <h2>Not Legal Advice</h2>
    <p>The waivers generated by WaiverMaker.com are not legal advice and do not create an attorney-client relationship. You should consult a licensed attorney in your jurisdiction to ensure any waiver meets your specific legal needs and is enforceable under local law.</p>
    <h2>Payment and Refunds</h2>
    <p>Waiver downloads are $9.99 per document. Due to the digital nature of the product, we do not offer refunds after a PDF has been downloaded. If you experience a technical issue preventing download, contact us at support@waivermaker.com.</p>
    <h2>Acceptable Use</h2>
    <p>You may use WaiverMaker.com only for lawful purposes. You may not use generated documents for fraudulent purposes or misrepresent the legal status of generated waivers.</p>
    <h2>Limitation of Liability</h2>
    <p>WaiverMaker.com is not liable for the legal sufficiency, enforceability, or outcome of any waiver generated using our service. Use of generated documents is entirely at your own risk.</p>
    <h2>Contact</h2>
    <p>Questions? Email <a href="mailto:support@waivermaker.com" style="color:var(--emerald);">support@waivermaker.com</a></p>
  </div>
  <Footer />
</Base>
