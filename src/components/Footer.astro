<style>
  .footer-logo-link {
    display: flex; align-items: center; gap: 12px; text-decoration: none;
  }
  .footer-logo-mark {
    width: 36px; height: 36px;
    background: linear-gradient(145deg, #059669, #047857);
    border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 14px rgba(5,150,105,0.25), inset 0 1px 0 rgba(255,255,255,0.12);
    flex-shrink: 0;
    position: relative;
  }
  .footer-logo-mark::after {
    content: ''; position: absolute; inset: 1px; border-radius: 8px;
    background: linear-gradient(145deg, rgba(255,255,255,0.14), transparent 60%);
  }
  .footer-logo-mark svg { position: relative; z-index: 1; }
  .footer-logo-text {
    display: flex; flex-direction: column; gap: 2px;
  }
  .footer-logo-name {
    font-family: 'Space Grotesk', 'Inter', sans-serif;
    font-size: 18px; font-weight: 700;
    color: white; letter-spacing: -0.4px; line-height: 1;
  }
  .footer-logo-name em {
    font-style: normal;
    background: linear-gradient(90deg, #10B981, #6EE7B7);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .footer-logo-sub {
    display: block;
    font-size: 9px; font-weight: 500;
    color: rgba(255,255,255,0.25);
    letter-spacing: 0.18em; text-transform: uppercase; margin-top: 2px;
  }
  .site-footer {
    background: #0f172a;
    color: #94a3b8;
    padding: 48px 40px 32px;
    margin-top: 60px;
  }
  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
  }
  .footer-logo {
    font-size: 20px;
    font-weight: 800;
    color: #fff;
    text-decoration: none;
  }
  .footer-logo span {
    color: var(--emerald, #059669);
  }
  .footer-tagline {
    font-size: 13px;
    margin-top: 10px;
    line-height: 1.6;
  }
  .footer-legal {
    font-size: 12px;
    margin-top: 16px;
    color: #64748b;
  }
  .footer-heading {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 10px;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .footer-col ul a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.15s;
  }
  .footer-col ul a:hover {
    color: #fff;
  }
  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
