---
const stats = [
  { num: '47K+', label: 'Waivers Generated' },
  { num: '20+',  label: 'Waiver Templates' },
  { num: '50',   label: 'States Covered' },
  { num: '100%', label: 'Free to Use' },
];
---
<section class="social-proof">
  <div class="proof-label">Trusted by small businesses across the US</div>
  <div class="proof-row">
    {stats.map(s => (
      <div class="proof-stat">
        <div class="num">{s.num}</div>
        <div class="label">{s.label}</div>
      </div>
    ))}
  </div>
</section>
