---
const stats = [
  { num: '8',    label: 'Waiver Types' },
  { num: '50',   label: 'States — Select Your Governing State' },
  { num: '3 min', label: 'Average Time to Generate' },
  { num: '100%', label: 'Free to Use' },
];
---
<section class="social-proof">
  <div class="proof-label">Built for small businesses across the US</div>
  <div class="proof-row">
    {stats.map(s => (
      <div class="proof-stat">
        <div class="num">{s.num}</div>
        <div class="label">{s.label}</div>
      </div>
    ))}
  </div>
</section>
