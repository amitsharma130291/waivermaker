---
const steps = [
  { num: 1, title: 'Pick Your Waiver', desc: 'Choose from 20+ activity-specific waiver templates.' },
  { num: 2, title: 'Fill Your Details', desc: 'Business name, state, activities covered. Takes 2 minutes.' },
  { num: 3, title: 'Preview Free', desc: 'See your completed waiver before paying a penny.' },
  { num: 4, title: 'Download PDF', desc: 'Download a print-ready, watermark-free PDF — completely free.' },
];
---
<section class="how" id="how-it-works">
  <h2>How it works</h2>
  <div class="steps">
    {steps.map(s => (
      <div class="step">
        <div class="step-num">{s.num}</div>
        <h4>{s.title}</h4>
        <p>{s.desc}</p>
      </div>
    ))}
  </div>
</section>
