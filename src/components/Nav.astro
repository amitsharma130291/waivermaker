<nav>
  <a href="/" class="logo-link" aria-label="WaiverTemplate Home">
    <div class="logo-mark">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 6 L6 18 L10 10 L12 15 L14 10 L18 18 L22 6" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="logo-text">
      <span class="logo-name">Waiver<em>Template</em></span>
      <span class="logo-sub">Free Waiver Generator</span>
    </div>
  </a>
  <div class="nav-links">
    <div class="nav-dropdown">
      <button class="nav-link-hide nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false">
        Waiver Types <span class="nav-caret">▾</span>
      </button>
    </div>
    <a href="/tattoo-waiver/template/" class="nav-link-hide">Templates</a>
    <a href="/about/" class="nav-link-hide">About</a>
    <a href="/contact/" class="nav-link-hide">Contact</a>
    <a href="/" class="nav-cta">Generate My Waiver</a>
  </div>
</nav>

<!-- Portal menu — appended to body by JS so it escapes ALL stacking contexts -->
<template id="nav-menu-tpl">
  <div id="nav-portal-menu" role="menu" style="
    display:none;
    position:fixed;
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:10px;
    box-shadow:0 16px 48px rgba(0,0,0,0.18);
    min-width:220px;
    z-index:2147483647;
    padding:8px 0 6px;
  ">
    <a href="/gym-waiver/" role="menuitem">💪 Gym &amp; Fitness</a>
    <a href="/tattoo-waiver/" role="menuitem">🎨 Tattoo Studio</a>
    <a href="/yoga-waiver/" role="menuitem">🧘 Yoga Studio</a>
    <a href="/volunteer-waiver/" role="menuitem">🤝 Volunteer</a>
    <a href="/rock-climbing-waiver/" role="menuitem">🧗 Rock Climbing</a>
    <a href="/dog-grooming-waiver/" role="menuitem">🐕 Dog Grooming</a>
    <a href="/horse-riding-waiver/" role="menuitem">🏇 Horse Riding</a>
    <a href="/personal-trainer-waiver/" role="menuitem">🏋️ Personal Trainer</a>
  </div>
</template>

<style>
  .logo-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .logo-mark {
    width: 46px;
    height: 46px;
    background: linear-gradient(145deg, #059669 0%, #047857 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(5,150,105,0.35), inset 0 1px 0 rgba(255,255,255,0.15);
    flex-shrink: 0;
    position: relative;
  }
  .logo-mark::after {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: 11px;
    background: linear-gradient(145deg, rgba(255,255,255,0.16), transparent 60%);
  }
  .logo-mark svg { position: relative; z-index: 1; }
  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .logo-name {
    font-family: 'Space Grotesk', 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: #0D1117;
    letter-spacing: -0.4px;
    line-height: 1;
  }
  .logo-name em {
    font-style: normal;
    color: #059669;
  }
  .logo-sub {
    font-size: 9px;
    font-weight: 500;
    color: #9CA3AF;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .nav-dropdown { position: relative; }
  .nav-dropdown-toggle {
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    padding: 0;
    color: inherit;
  }
  .nav-caret { font-size: 11px; margin-left: 2px; }

  /* Portal menu link styles injected via JS */
</style>

<script>
  // Clone menu from template and append to body (portal pattern)
  const tpl = document.getElementById('nav-menu-tpl') as HTMLTemplateElement | null;
  const toggle = document.querySelector('.nav-dropdown-toggle') as HTMLElement | null;

  if (tpl && toggle) {
    const menu = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;

    // Style the links inside
    const style = document.createElement('style');
    style.textContent = `
      #nav-portal-menu a {
        display: block;
        padding: 9px 18px;
        font-size: 14px;
        color: #0f172a;
        text-decoration: none;
        white-space: nowrap;
        font-family: 'Inter', sans-serif;
      }
      #nav-portal-menu a:hover {
        background: #f0fdf4;
        color: #059669;
      }
    `;
    document.head.appendChild(style);
    document.body.appendChild(menu);

    let hideTimer: ReturnType<typeof setTimeout> | null = null;

    const show = () => {
      if (hideTimer) clearTimeout(hideTimer);
      const rect = toggle.getBoundingClientRect();
      menu.style.top = (rect.bottom + 6) + 'px';
      menu.style.left = rect.left + 'px';
      menu.style.display = 'block';
      toggle.setAttribute('aria-expanded', 'true');
    };

    const hide = () => {
      hideTimer = setTimeout(() => {
        menu.style.display = 'none';
        toggle.setAttribute('aria-expanded', 'false');
      }, 120);
    };

    toggle.addEventListener('mouseenter', show);
    toggle.addEventListener('mouseleave', hide);
    toggle.addEventListener('click', () => {
      menu.style.display === 'block' ? hide() : show();
    });
    menu.addEventListener('mouseenter', () => { if (hideTimer) clearTimeout(hideTimer); });
    menu.addEventListener('mouseleave', hide);

    document.addEventListener('click', (e) => {
      if (!toggle.contains(e.target as Node) && !menu.contains(e.target as Node)) {
        menu.style.display = 'none';
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
