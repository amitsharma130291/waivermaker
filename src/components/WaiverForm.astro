---
export interface Props {
  preselectedActivity?: string;
}
const { preselectedActivity = 'Gym/Fitness' } = Astro.props;

import { serializeAllChecklists, serializeWaiverDefinition } from '../data/waiver-definitions';

const US_STATES = [
  'Alabama','Alaska','Arizona','Arkansas','California','Colorado','Connecticut',
  'Delaware','Florida','Georgia','Hawaii','Idaho','Illinois','Indiana','Iowa',
  'Kansas','Kentucky','Louisiana','Maine','Maryland','Massachusetts','Michigan',
  'Minnesota','Mississippi','Missouri','Montana','Nebraska','Nevada','New Hampshire',
  'New Jersey','New Mexico','New York','North Carolina','North Dakota','Ohio',
  'Oklahoma','Oregon','Pennsylvania','Rhode Island','South Carolina','South Dakota',
  'Tennessee','Texas','Utah','Vermont','Virginia','Washington','West Virginia',
  'Wisconsin','Wyoming'
];

const ACTIVITY_TYPES = [
  'Gym/Fitness','Tattoo Studio','Yoga Studio','Dog Grooming',
  'Rock Climbing','Horse Riding','Volunteer','Personal Training'
];

// Serialize the checklists for all activity types for browser use
const allChecklistsJSON = JSON.stringify(serializeAllChecklists());

// Pre-render a baseline definition for the preselected activity so the
// browser has a starting point before the user fills in any fields.
// The browser will re-interpolate user values client-side using this structure.
const baselineDefinitionJSON = JSON.stringify(
  serializeWaiverDefinition(preselectedActivity, {
    businessName: '[Business Name]',
    state: '[State]',
    ownerName: '[Owner / Manager]',
    businessAddress: '[Address]',
    activityType: preselectedActivity,
  })
);
---

<div class="form-wrapper" id="generator">
  <!-- Progress bar -->
  <div class="form-progress" id="form-progress">
    <div class="progress-step active-step" id="step-indicator-1">
      <div class="dot">1</div><span>Business Info</span>
    </div>
    <span class="step-arrow">›</span>
    <div class="progress-step inactive" id="step-indicator-2">
      <div class="dot">2</div><span>Waiver Details</span>
    </div>
    <span class="step-arrow">›</span>
    <div class="progress-step inactive" id="step-indicator-3">
      <div class="dot">3</div><span>Preview &amp; Download</span>
    </div>
  </div>

  <div class="form-inner">

    <!-- Step 1: Business Info -->
    <div id="step-1" class="form-step">
      <div class="form-grid">
        <div class="form-group">
          <label for="business-name">Business Name</label>
          <input type="text" id="business-name" name="businessName" placeholder="Iron Peak Gym" required />
        </div>
        <div class="form-group">
          <label for="state">State</label>
          <select id="state" name="state" required>
            <option value="">Select your state</option>
            {US_STATES.map(s => <option value={s}>{s}</option>)}
          </select>
          <p class="state-helper">Selecting a state sets the governing-law section of your document. It does not mean WaiverTemplate has verified that this document satisfies every legal requirement in that state.</p>
        </div>
        <div class="form-group">
          <label for="owner-name">Owner / Manager Name</label>
          <input type="text" id="owner-name" name="ownerName" placeholder="John Smith" required />
        </div>
        <div class="form-group">
          <label for="contact-email">Contact Email</label>
          <input type="email" id="contact-email" name="contactEmail" placeholder="john@ironpeak.com" required />
        </div>
        <div class="form-group full">
          <label for="business-address">Business Address</label>
          <input type="text" id="business-address" name="businessAddress" placeholder="123 Main St, Los Angeles, CA 90001" required />
        </div>
      </div>
      <button type="button" class="form-submit" id="next-step-1">
        Next: Waiver Details →
      </button>
      <div class="form-note">🔒 No account needed · Preview free · Download free</div>
    </div>

    <!-- Step 2: Waiver Details -->
    <div id="step-2" class="form-step" style="display:none">
      <div class="form-grid">
        <div class="form-group full">
          <label for="activity-type">Activity Type</label>
          <select id="activity-type" name="activityType">
            {ACTIVITY_TYPES.map(a => (
              <option value={a} selected={a === preselectedActivity}>{a}</option>
            ))}
          </select>
        </div>
        <div class="waiver-includes-card full" aria-live="polite">
          <strong id="waiver-includes-title">Your waiver includes:</strong>
          <ul id="waiver-includes-list"></ul>
        </div>
        <div class="form-group full">
          <label for="activity-description">Description of Activities</label>
          <textarea id="activity-description" name="activityDescription" placeholder="Describe the activities participants will engage in..." rows={3}></textarea>
        </div>
        <div class="form-group full">
          <label for="specific-risks">Specific Risks to Disclose</label>
          <textarea id="specific-risks" name="specificRisks" placeholder="List any specific risks (e.g. risk of muscle strain, equipment malfunction, slip and fall)..." rows={3}></textarea>
        </div>
        <div class="form-group full">
          <label for="min-age">Participant Minimum Age</label>
          <select id="min-age" name="minAge">
            <option value="18+">18+ (Adults only)</option>
            <option value="16+ with guardian">16+ with guardian consent</option>
            <option value="All ages">All ages (with parental consent for minors)</option>
          </select>
        </div>
        <div class="form-group full">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-weight:500;">
            <input type="checkbox" id="emergency-contact" name="emergencyContact" style="width:auto;margin:0;" />
            Require emergency contact information on waiver
          </label>
        </div>
        <div class="form-group full">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-weight:500;">
            <input type="checkbox" id="photo-consent" name="photoConsent" style="width:auto;margin:0;" />
            Include optional photo / media consent clause
          </label>
        </div>
      </div>
      <div style="display:flex;gap:12px;margin-top:8px;">
        <button type="button" class="form-submit" id="back-step-2" style="background:white;color:var(--emerald);border:1.5px solid var(--emerald);flex:0 0 auto;width:auto;padding:15px 24px;">
          ← Back
        </button>
        <button type="button" class="form-submit" id="next-step-2" style="flex:1;">
          Preview My Waiver — Free →
        </button>
      </div>
      <div class="form-note">🔒 No account needed · Preview free · Download free</div>
    </div>

    <!-- Step 3: Preview & Download -->
    <div id="step-3" class="form-step" style="display:none">
      <div class="waiver-preview" id="waiver-preview-text">
        <!-- Populated by JS using shared definition data -->
      </div>
      <button type="button" class="form-submit" id="download-btn">
        Download Free PDF →
      </button>
      <div class="form-note">🔒 Instant download · Not legal advice</div>
      <div style="margin-top:12px;text-align:center;">
        <button type="button" id="back-step-3" style="background:none;border:none;color:var(--emerald);cursor:pointer;font-size:13px;font-family:Inter,sans-serif;">
          ← Edit details
        </button>
      </div>
    </div>

  </div>
</div>

<details class="how-waivertemplate-works">
  <summary>How WaiverTemplate works</summary>
  <div>
    <h3>What WaiverTemplate does</h3>
    <p>WaiverTemplate creates customisable waiver templates based on the information you provide and the type of activity you select. The generated document includes commonly used provisions relevant to that activity, populated with your business details.</p>
    <h3>What WaiverTemplate doesn't do</h3>
    <p>WaiverTemplate is not a law firm and does not provide legal advice. We don't determine whether a waiver is enforceable in your jurisdiction, or guarantee that a generated document satisfies every law, regulation, insurer requirement, or circumstance applicable to your business. For legal advice, consult a licensed attorney in your state.</p>
  </div>
</details>

<!-- Shared definition data embedded server-side — used by client JS below -->
<script type="application/json" id="wm-checklists">{allChecklistsJSON}</script>
<script type="application/json" id="wm-baseline-definition">{baselineDefinitionJSON}</script>

<script>
  // ---------------------------------------------------------------------------
  // Load shared definition data — defensive parse so script never crashes
  // ---------------------------------------------------------------------------
  let allChecklists: Record<string, string[]> = {};
  try {
    const raw = document.getElementById('wm-checklists')?.textContent;
    if (raw) allChecklists = JSON.parse(raw);
  } catch (e) {
    console.error('[WaiverForm] Failed to parse wm-checklists:', e);
  }

  // Form data store
  const formData: Record<string, string | boolean> = {};

  // Step navigation helpers
  function showStep(n: number) {
    [1, 2, 3].forEach(i => {
      const el = document.getElementById(`step-${i}`);
      if (el) el.style.display = i === n ? '' : 'none';
      const ind = document.getElementById(`step-indicator-${i}`);
      if (ind) {
        ind.classList.remove('inactive');
        if (i > n) ind.classList.add('inactive');
      }
    });
  }

  function collectStep1(): boolean {
    const businessName = (document.getElementById('business-name') as HTMLInputElement)?.value.trim();
    const state = (document.getElementById('state') as HTMLSelectElement)?.value;
    const ownerName = (document.getElementById('owner-name') as HTMLInputElement)?.value.trim();
    const contactEmail = (document.getElementById('contact-email') as HTMLInputElement)?.value?.trim() || '';
    const businessAddress = (document.getElementById('business-address') as HTMLInputElement)?.value.trim();

    if (!businessName) { alert('Please enter your business name.'); return false; }
    if (!state) { alert('Please select your state.'); return false; }
    if (!ownerName) { alert('Please enter the owner / manager name.'); return false; }
    if (!contactEmail || !contactEmail.includes('@')) { alert('Please enter a valid contact email.'); return false; }
    if (!businessAddress) { alert('Please enter your business address.'); return false; }

    formData.businessName = businessName;
    formData.state = state;
    formData.ownerName = ownerName;
    formData.contactEmail = contactEmail;
    formData.businessAddress = businessAddress;
    return true;
  }

  function collectStep2() {
    formData.activityType = (document.getElementById('activity-type') as HTMLSelectElement)?.value || 'Gym/Fitness';
    formData.activityDescription = (document.getElementById('activity-description') as HTMLTextAreaElement)?.value.trim();
    formData.specificRisks = (document.getElementById('specific-risks') as HTMLTextAreaElement)?.value.trim();
    formData.minAge = (document.getElementById('min-age') as HTMLSelectElement)?.value || '18+';
    formData.emergencyContact = (document.getElementById('emergency-contact') as HTMLInputElement)?.checked;
    formData.photoConsent = (document.getElementById('photo-consent') as HTMLInputElement)?.checked;
  }

  // ---------------------------------------------------------------------------
  // Build preview HTML from the shared waiver definition data.
  // We call the server API to get sections for the current form state,
  // then render them as HTML matching the PDF section structure.
  // ---------------------------------------------------------------------------
  async function buildWaiverPreview(): Promise<string> {
    const params = new URLSearchParams();
    Object.entries(formData).forEach(([k, v]) => params.set(k, String(v)));

    // Fetch the rendered sections from the PDF endpoint with format=sections
    // Since the endpoint doesn't return JSON sections directly, we build the
    // preview HTML by interpolating user values into the same template
    // structure produced by the shared definitions module on the server.
    // We fetch a lightweight JSON definitions endpoint.
    const res = await fetch(`/api/waiver-sections?${params.toString()}`).catch(() => null);
    if (res && res.ok) {
      const sections: Array<{ id: string; title: string; body: string }> = await res.json();
      return renderSectionsToHTML(sections);
    }

    // Fallback: render using placeholder text when the API isn't available
    return renderFallbackPreview();
  }

  function renderSectionsToHTML(sections: Array<{ id: string; title: string; body: string }>): string {
    const bn = formData.businessName as string || '[Business Name]';
    const st = formData.state as string || '[State]';
    const own = formData.ownerName as string || '[Owner]';
    const addr = formData.businessAddress as string || '';

    let html = `
      <h3>LIABILITY WAIVER AND RELEASE</h3>
      <p><strong>${bn}</strong>${addr ? ' | ' + addr : ''} | ${st}</p>
      <p><strong>Owner/Manager:</strong> ${own}</p>
      <hr style="border:none;border-top:1px solid #E5E7EB;margin:12px 0;" />
    `;

    const unnumbered = new Set(['governing-law', 'signature', 'emergency-contact']);
    let num = 0;
    for (const section of sections) {
      const label = unnumbered.has(section.id)
        ? `<strong>${section.title}</strong>`
        : `<strong>${++num}. ${section.title}</strong>`;
      // Preserve line breaks in signature / emergency contact sections
      const bodyHtml = section.body.replace(/\n/g, '<br/>');
      html += `<p>${label}: ${bodyHtml}</p>`;
    }

    html += `<p style="margin-top:12px;font-size:10px;color:#9CA3AF;text-align:center;">Generated by WaiverTemplate.com — Not legal advice. Consult an attorney for your specific situation.</p>`;
    return html;
  }

  function renderFallbackPreview(): string {
    const bn = formData.businessName as string || '[Business Name]';
    const st = formData.state as string || '[State]';
    const own = formData.ownerName as string || '[Owner]';
    const at = formData.activityType as string || 'the selected activity';
    const risks = formData.specificRisks as string;
    const actDesc = formData.activityDescription as string;
    const ec = formData.emergencyContact;

    return `
      <h3>LIABILITY WAIVER AND RELEASE</h3>
      <p><strong>${bn}</strong> | ${formData.businessAddress} | ${st}</p>
      <p><strong>Owner/Manager:</strong> ${own}</p>
      <hr style="border:none;border-top:1px solid #E5E7EB;margin:12px 0;" />
      <p><strong>1. ASSUMPTION OF RISK:</strong> I understand that ${at} activities offered by ${bn} involve inherent and other risks, including ${risks || 'risks of injury, illness, property damage, and other hazards'}. I voluntarily choose to participate and release ${bn} and its owners, staff, agents, and contractors from claims arising from those inherent risks, to the extent permitted by applicable law.</p>
      <p><strong>2. INDEMNIFICATION:</strong> I agree to indemnify and hold harmless ${bn} and its representatives from losses, liability, damage, or costs resulting from my own acts or omissions while participating in these activities.</p>
      <p><strong>3. EMERGENCY MEDICAL AUTHORIZATION:</strong> If I am incapacitated in an emergency, I authorise ${bn} to seek emergency medical treatment for me. I understand that I remain responsible for related medical costs.</p>
      ${actDesc ? `<p><strong>4. ACTIVITY DETAILS:</strong> The activity includes: ${actDesc}.</p>` : ''}
      ${ec ? '<p><strong>EMERGENCY CONTACT:</strong> Name: _________________ Phone: _________________</p>' : ''}
      <p><strong>GOVERNING LAW:</strong> This document is governed by the laws of the State of ${st}.</p>
      <p><strong>SIGNATURE:</strong> Participant Signature: _________________________________ Date: ___________<br/>Printed Name: _________________________________</p>
      <p style="margin-top:12px;font-size:10px;color:#9CA3AF;text-align:center;">Generated by WaiverTemplate.com — Not legal advice. Consult an attorney for your specific situation.</p>
    `;
  }

  // ---------------------------------------------------------------------------
  // Checklist — uses the shared definitions data embedded by the server
  // ---------------------------------------------------------------------------
  function updateInclusionList() {
    try {
      const activity = (document.getElementById('activity-type') as HTMLSelectElement)?.value || 'Gym/Fitness';
      const list = document.getElementById('waiver-includes-list');
      const items = allChecklists[activity] || allChecklists['Gym/Fitness'] || [];
      if (list) list.innerHTML = items.map(item => `<li>✓ ${item}</li>`).join('');
    } catch (e) {
      console.error('[WaiverForm] updateInclusionList error:', e);
    }
  }
  updateInclusionList();
  document.getElementById('activity-type')?.addEventListener('change', updateInclusionList);

  // ---------------------------------------------------------------------------
  // Event listeners
  // ---------------------------------------------------------------------------
  document.getElementById('next-step-1')?.addEventListener('click', () => {
    if (collectStep1()) showStep(2);
  });

  document.getElementById('back-step-2')?.addEventListener('click', () => showStep(1));

  document.getElementById('next-step-2')?.addEventListener('click', async () => {
    try {
      collectStep2();
      const preview = document.getElementById('waiver-preview-text');
      if (preview) {
        preview.innerHTML = '<p style="color:#6B7280;text-align:center;">Building preview…</p>';
        showStep(3);
        try {
          preview.innerHTML = await buildWaiverPreview();
        } catch (e) {
          console.error('[WaiverForm] buildWaiverPreview error:', e);
          preview.innerHTML = renderFallbackPreview();
        }
      } else {
        showStep(3);
      }
    } catch (e) {
      console.error('[WaiverForm] next-step-2 handler error:', e);
      showStep(3);
    }
  });

  document.getElementById('back-step-3')?.addEventListener('click', () => showStep(2));

  document.getElementById('download-btn')?.addEventListener('click', () => {
    const params = new URLSearchParams();
    Object.entries(formData).forEach(([k, v]) => params.set(k, String(v)));
    window.location.href = `/api/generate-pdf?${params.toString()}`;
  });

  // Sync type picker selection (homepage TypePicker buttons)
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-value]') as HTMLElement | null;
    if (btn && btn.dataset.value) {
      const sel = document.getElementById('activity-type') as HTMLSelectElement | null;
      if (sel) {
        sel.value = btn.dataset.value;
        updateInclusionList();
      }
    }
  });
</script>
